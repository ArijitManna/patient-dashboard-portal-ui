# Example environment variables for Patient Dashboard Portal
# Base URL selection
# Optional: explicit override for all environments
REACT_APP_API_BASE_URL=

# Optional: set explicit dev/prod base URLs. If REACT_APP_API_BASE_URL is set it takes precedence.
REACT_APP_API_BASE_URL_DEV=http://localhost:5094/api
REACT_APP_API_BASE_URL_PROD=http://198.38.81.123:9003/api

# API secret header (used by selected protected endpoints)
REACT_APP_API_SECRETKEY=
REACT_APP_API_SECRET_APIS=

# Other env variables
# REACT_APP_OTHER_CONFIG=
